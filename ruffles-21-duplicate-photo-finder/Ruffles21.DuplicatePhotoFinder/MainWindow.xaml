<Window x:Class="Ruffles21.DuplicatePhotoFinder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ruffles21.DuplicatePhotoFinder" Title="ruffles_21’s Duplicate Photo Finder" Width="1440" Height="980" MinWidth="1080" MinHeight="720" Background="#F3F5F8" FontFamily="Segoe UI" Foreground="#182B3A">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#146B58" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CFD8E1" />
            <Setter Property="Foreground" Value="#203F49" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="BorderBrush" Value="#168B76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9" />
            <Setter Property="BorderBrush" Value="#CFD8E1" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="selection" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="selection" Property="BorderBrush" Value="#637DA7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="GalleryCard">
            <Border Width="220" Margin="0,4,12,4" Padding="10" BorderThickness="2" CornerRadius="10" Background="White" BorderBrush="{Binding BorderColor}">
                <StackPanel>
                    <Grid Height="138" Background="#EDF1F4">
                        <TextBlock Text="{Binding StatusText, ElementName=GalleryThumbnail}" Foreground="#657786" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12" />
                        <local:Thumbnail x:Name="GalleryThumbnail" FilePath="{Binding Path}" />
                        <Border Background="#E3F4EC" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Keep" Foreground="#146B58" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,9,0,4" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#657786" />
                    <CheckBox IsChecked="{Binding Marked, Mode=TwoWay}" IsEnabled="{Binding CanMark}" Content="{Binding Status}" Margin="0,9,0,0" Foreground="{Binding BorderColor}" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactCard">
            <Border Width="160" Margin="0,4,10,4" Padding="8" BorderThickness="2" CornerRadius="8" BorderBrush="{Binding BorderColor}" Background="White">
                <StackPanel>
                    <local:Thumbnail FilePath="{Binding Path}" Height="78" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding Detail}" FontSize="9" />
                    <CheckBox IsChecked="{Binding Marked}" IsEnabled="{Binding CanMark}" Content="{Binding Status}" Foreground="{Binding BorderColor}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RowCard">
            <Border BorderBrush="{Binding BorderColor}" BorderThickness="3,0,0,1" Padding="10" Margin="0,2" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <local:Thumbnail FilePath="{Binding Path}" Height="52" />
                    <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Marked}" IsEnabled="{Binding CanMark}" Content="{Binding Status}" Foreground="{Binding BorderColor}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GroupTemplate">
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E7EC" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding Id, StringFormat=Duplicate group {0}}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding CopyCount, StringFormat={}{0} copies · Verified exact}" Foreground="#52796B" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Photos}" ItemTemplate="{DynamicResource PhotoTemplate}" ItemsPanel="{DynamicResource PhotoPanel}" Height="{DynamicResource GroupHeight}" Background="Transparent" BorderThickness="0" SelectionChanged="Inspect" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Mark Other Copies" Click="MarkGroup" />
                        <Button Content="Unmark Group" Click="UnmarkGroup" />
                        <Button Content="Expand Details" Click="GroupDetails" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SimilarCard">
            <Border Width="{DynamicResource SimilarCardWidth}" Margin="0,4,12,4" Padding="10" BorderThickness="1" CornerRadius="10" Background="White" BorderBrush="#D9C59B">
                <StackPanel>
                    <Grid Height="{DynamicResource SimilarImageHeight}" Background="#EDF1F4">
                        <TextBlock Text="{Binding StatusText, ElementName=SimilarThumbnail}" Foreground="#657786" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12" />
                        <local:Thumbnail x:Name="SimilarThumbnail" FilePath="{Binding Path}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,9,0,4" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#657786" />
                    <TextBlock Text="SIMILAR · review only" Foreground="#936A20" FontSize="11" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SimilarRowCard">
            <Border Padding="10" Margin="0,2" BorderBrush="#D9C59B" BorderThickness="3,0,0,1" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="135" />
                    </Grid.ColumnDefinitions>
                    <local:Thumbnail FilePath="{Binding Path}" Height="52" />
                    <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Review only" Foreground="#936A20" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SimilarGroupTemplate">
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="#E4DBC7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding Detail}" Foreground="#846B3C" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <ListBox ItemsSource="{Binding Photos}" ItemTemplate="{DynamicResource SimilarPhotoTemplate}" ItemsPanel="{DynamicResource PhotoPanel}" Height="{DynamicResource GroupHeight}" Background="Transparent" BorderThickness="0" SelectionChanged="Inspect" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="#F3F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#132F32" Padding="24,15">
            <DockPanel>
                <TextBlock Text="ruffles_21’s Duplicate Photo Finder" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="A clearer view of your library" Foreground="#B9D3CC" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="24,20,24,16">
            <DockPanel>
                <TextBlock Text="Keep the moments that matter." FontSize="24" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ManageButton" Content="Manage folders" Click="ManageFolders" />
                    <Button x:Name="ChooseButton" Content="Choose folders &amp; scan" Click="ChooseFolders" Background="#146B58" Foreground="White" />
                </StackPanel>
            </DockPanel>
            <WrapPanel x:Name="ScanChoices" Margin="0,12,0,0">
                <TextBlock Text="FIND" FontSize="11" Foreground="#657786" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="ScanExactChoice" Content="Exact duplicates" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" />
                <CheckBox x:Name="ScanSimilarChoice" Content="Similar photos &amp; videos" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox x:Name="SimilarityLevel" Width="170" SelectedIndex="1" Padding="7" IsEnabled="{Binding IsChecked, ElementName=ScanSimilarChoice}">
                    <ComboBoxItem>Strict similarity</ComboBoxItem>
                    <ComboBoxItem>Balanced similarity</ComboBoxItem>
                    <ComboBoxItem>Broader similarity</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Choose one or both" Foreground="#657786" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
            <TextBlock x:Name="Summary" Text="Choose your folders to find identical photos and videos." Foreground="#536C7A" FontSize="14" Margin="0,9,0,15" TextWrapping="Wrap" />
            <ProgressBar x:Name="ScanActivity" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#146B58" Margin="0,0,0,12" />
            <WrapPanel x:Name="Toolbar">
                <StackPanel x:Name="ExactActions" Orientation="Horizontal">
                    <Button Content="Auto Mark" Click="AutoMark" Background="#146B58" Foreground="White" />
                    <Button Content="Unmark All" Click="UnmarkAll" />
                    <ComboBox x:Name="Rules" Visibility="Collapsed" SelectedIndex="0">
                        <ComboBoxItem>Keep shortest path</ComboBoxItem>
                        <ComboBoxItem>Keep shortest filename</ComboBoxItem>
                        <ComboBoxItem>Keep oldest file</ComboBoxItem>
                        <ComboBoxItem>Keep newest file</ComboBoxItem>
                        <ComboBoxItem>Keep files in preferred folder</ComboBoxItem>
                        <ComboBoxItem>Keep files outside backup folders</ComboBoxItem>
                    </ComboBox>
                    <Button Content="Selection Assistant ▾" Click="AssistantSettings" />
                </StackPanel>
                <Button Content="Export Report ▾" Click="ExportMenu" />
                <Button x:Name="GalleryButton" Content="Gallery View" Click="Gallery" />
                <Button x:Name="CompactButton" Content="Compact View" Click="Compact" />
                <Button x:Name="ListButton" Content="List View" Click="ListView" />
            </WrapPanel>
            <DockPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ExactTab" Content="Exact (0)" Click="ShowExact" />
                    <Button x:Name="SimilarTab" Content="Similar (0)" Click="ShowSimilar" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Search" VerticalAlignment="Center" Foreground="#657786" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Width="230" Padding="8,5" ToolTip="Search file names and folders" TextChanged="FilterChanged" />
                    <ComboBox x:Name="MediaScope" SelectedIndex="0" Width="110" Padding="6" Margin="8,0,0,0" SelectionChanged="FilterChanged">
                        <ComboBoxItem>All media</ComboBoxItem>
                        <ComboBoxItem>Photos</ComboBoxItem>
                        <ComboBoxItem>Videos</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="FilterHint" Text="Search file names or folders · Marking actions apply to all exact results" FontSize="11" Foreground="#657786" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="GroupsList" ItemTemplate="{StaticResource GroupTemplate}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <ListBox x:Name="SimilarList" Visibility="Collapsed" ItemTemplate="{StaticResource SimilarGroupTemplate}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock x:Name="EmptyHeading" Text="Keep the memories. Lose the duplicates." FontSize="25" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyDescription" Text="Add folders to scan. One original stays protected in every group. You choose what goes." FontSize="15" Foreground="#657786" TextWrapping="Wrap" TextAlignment="Center" Margin="12,20" />
                    <Button x:Name="EmptyAction" Content="Choose folders &amp; scan" Click="EmptyActionClick" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
                <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" FontWeight="Bold" Foreground="#657786" Margin="0,0,0,12" />
                        <StackPanel>
                            <Border Background="#EEF2F5" Height="200" MouseLeftButtonUp="Enlarge" Cursor="Hand">
                                <Grid>
                                    <TextBlock x:Name="PreviewHint" Text="Select a photo to inspect" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#657786" TextWrapping="Wrap" Margin="12" />
                                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PreviewStatus" Margin="0,12" FontWeight="Bold" />
                            <WrapPanel x:Name="PreviewExactActions">
                                <Button Content="Keep This Copy" Click="KeepThis" />
                                <Button Content="Mark to remove" Click="MarkThis" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,12">
                                <Button Content="Open Folder" Click="OpenFolder" />
                                <Button Content="Open File" Click="OpenFile" />
                                <Button Content="Zoom" Click="ZoomClick" />
                            </WrapPanel>
                            <TextBlock Text="METADATA" Foreground="#657786" FontWeight="Bold" Margin="0,0,0,12" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="Metadata" Text="Your photo details will appear here." TextWrapping="Wrap" Foreground="#435D6B" />
                            <Expander Header="Advanced Details" Margin="0,20,0,0">
                                <TextBox x:Name="HashText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" />
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" Padding="24,16" BorderBrush="#DBE2E8" BorderThickness="0,1,0,0" Margin="0,18,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="RemoveButton" Content="Move Selected to Recycle Bin (0)" Click="RemoveSelected" Background="#146B58" Foreground="White" IsEnabled="False" />
                <StackPanel>
                    <WrapPanel>
                        <Button x:Name="NewScanButton" Content="New scan" Click="ChooseFolders" />
                        <Button x:Name="PauseButton" Content="Pause" Click="PauseScan" IsEnabled="False" />
                        <Button x:Name="StopButton" Content="Stop" Click="StopScan" IsEnabled="False" />
                        <Button Content="Scan log" Click="ShowLog" />
                    </WrapPanel>
                    <TextBlock x:Name="ProgressText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Ready · Your original copies stay protected" Margin="0,8,0,0" Foreground="#657786" />
                    <TextBlock x:Name="SelectionText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,4,0,0" FontSize="11" Foreground="#657786" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>